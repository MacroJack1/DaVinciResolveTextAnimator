-- The output is created before any control.  If one cosmetic control is
-- rejected by this Fusion build, the tool still has a valid Output, so
-- Process() keeps running and Media Out receives an image instead of the
-- "cannot get Parameter for Input" failure.  A broken control is reported in
-- the console instead of taking the whole tool down.
function Create()
    local okIO, errIO = pcall(buildIO)
    if not okIO then
        dbg("Create: image I/O failed:", tostring(errIO))
    end
    if not OutImage then
        -- Last resort: without an Output the tool cannot render at all.
        local okOut, errOut = pcall(makeOutput)
        if not okOut or not OutImage then
            dbg("Create: output creation failed:", tostring(errOut))
        end
    end
    dbg("Create: output created")

    local ok, err = pcall(buildControls)
    if not ok then
        dbg("Create: control creation failed:", tostring(err))
        pcall(print, "[Text Animator] Control creation failed: " .. tostring(err))
    end

    dbg("Create: done",
        " text=", tostring(InText ~= nil),
        " font=", tostring(InFont ~= nil),
        " preset=", tostring(InPreset ~= nil))
end

-----------------------------------------------------------------------------
-- NotifyChanged
-----------------------------------------------------------------------------

local function setVisible(input, visible)
    if input then
        pcall(function()
            input:SetAttrs({ IC_Visible = visible and true or false })
        end)
    end
end

local function applyPreset(index, time)
    local values = E.presetValues(index)
    local map = PresetInputs
    if not map then return end
    for key, value in pairs(values) do
        local input = map[key]
        if input then
            pcall(function()
                input:SetSource(Number(value), time or 0)
            end)
        end
    end
end

function NotifyChanged(inp, param, time)
    if inp == InFont then
        local f = param and param.Value
        if f == nil or tostring(f):len() == 0 then
            pcall(function() InFont:SetSource(Text("Arial"), time or 0) end)
        end
    elseif inp == InFontStyle then
        local f = param and param.Value
        if f == nil or tostring(f):len() == 0 then
            pcall(function() InFontStyle:SetSource(Text("Regular"), time or 0) end)
        end
    elseif inp == InPreset then
        if param then selectedPreset = math.floor(tonumber(param.Value) or 0) end
    elseif inp == InApplyPreset then
        local pressed = param and (tonumber(param.Value) or 0) > 0.5
        if pressed then
            local index = selectedPreset
            local ok, v = pcall(function() return InPreset:GetSource(time or 0) end)
            if ok and v and v.Value ~= nil then
                index = math.floor(tonumber(v.Value) or index)
            end
            applyPreset(index, time)
            -- Reset the button.  Fusion stores input values in the comp, so a
            -- button left at 1 would fire again on every comp load and quietly
            -- overwrite the animation values saved by the user.
            pcall(function() InApplyPreset:SetSource(Number(0), time or 0) end)
        end
    end
end

--===========================================================================
-- PART 3 - RENDERING
--===========================================================================

local TRANSPARENT = { R = 0, G = 0, B = 0, A = 0 }

local function getNum(input, req, default)
    if not input then return default end
    local ok, v = pcall(function() return input:GetValue(req) end)
    if ok and v and v.Value ~= nil then
        local n = tonumber(v.Value)
        if n ~= nil then return n end
    end
    return default
end

local function getText(input, req, default)
    if not input then return default end
    local ok, v = pcall(function() return input:GetValue(req) end)
    if ok and v and v.Value ~= nil then return tostring(v.Value) end
    return default
end

local function getPoint(input, req, dx, dy)
    if not input then return dx, dy end
    local ok, v = pcall(function() return input:GetValue(req) end)
    if ok and v then
        return tonumber(v.X) or dx, tonumber(v.Y) or dy
    end
    return dx, dy
end

local function getImage(input, req)
    if not input then return nil end
    local ok, v = pcall(function() return input:GetValue(req) end)
    if ok then return v end
    return nil
end

-- Temporary render diagnostics live in PART 0 near the top of this file so
-- that Create() can use them too.

-- Logs the real pixel dimensions and the data window (DoD) of an image.
-- A valid image with an empty data window is the classic reason a downstream
-- node reports "cannot get Parameter for Input".
local function describeImage(tag, img)
    if not img then
        dbg(tag, "nil image")
        return
    end
    local ok, err = pcall(function()
        local dw = img.DataWindow
        if not dw then
            dbg(tag, "size=", tostring(img.Width), "x", tostring(img.Height), "no DataWindow")
            return
        end
        local dwW = dw:Width()
        local dwH = dw:Height()
        dbg(tag,
            "size=", tostring(img.Width), "x", tostring(img.Height),
            "dod=", tostring(dw.left), ",", tostring(dw.bottom), ",",
            tostring(dw.right), ",", tostring(dw.top),
            "dim=", tostring(dwW), "x", tostring(dwH))
    end)
    if not ok then
        dbg(tag, "size=", tostring(img.Width), "x", tostring(img.Height),
            "DataWindow unreadable:", tostring(err))
    end
end

-- Coarse alpha probe used by the diagnostics. Read-only: samples a grid and
-- reports how many samples are non-transparent, so the log can distinguish
-- "nothing was drawn" from "the composite lost the layer".
local function alphaCoverage(img, stepX, stepY)
    if not img then return 0, 0, 0, 0, 0, 0 end
    stepX = stepX or 48
    stepY = stepY or 48
    local total, hit, maxA = 0, 0, 0
    local maxR, maxG, maxB = 0, 0, 0
    local px = Pixel({ R = 0, G = 0, B = 0, A = 0 })
    for y = 0, img.Height - 1, stepY do
        for x = 0, img.Width - 1, stepX do
            total = total + 1
            local ok = pcall(function() img:GetPixel(x, y, px) end)
            if ok and px and tonumber(px.A) and px.A > 0.001 then
                hit = hit + 1
                if px.A > maxA then
                    maxA = px.A
                    maxR = tonumber(px.R) or 0
                    maxG = tonumber(px.G) or 0
                    maxB = tonumber(px.B) or 0
                end
            end
        end
    end
    return hit, total, maxA, maxR, maxG, maxB
end

-- Reports whether the image's data window covers the whole frame.  This is
-- read-only on purpose: the Fuse SDK documents that writing outside the data
-- window may crash the host, so this build never touches pixels to repair it.
local function ensureFullDataWindow(img, W, H)
    if not img then return false, "nil image" end
    local ok, dw = pcall(function() return img.DataWindow end)
    if not ok or not dw then return false, "no DataWindow" end
    local okW, dwW = pcall(function() return dw:Width() end)
    local okH, dwH = pcall(function() return dw:Height() end)
    if okW and okH and tonumber(dwW) and tonumber(dwH) then
        if dwW >= W and dwH >= H then return true, "already full" end
        return false, "smaller than frame (" .. tostring(dwW) .. "x" .. tostring(dwH) .. ")"
    end
    return false, "DataWindow size unreadable"
end

local function compSize(tool)
    -- During Process, Fusion exposes the requested image size as globals.
    -- This is the documented way a generator discovers the comp format.
    local gw, gh = tonumber(Width), tonumber(Height)
    if gw and gh and gw > 0 and gh > 0 then
        return math.max(1, math.floor(gw + 0.5)), math.max(1, math.floor(gh + 0.5))
    end

    local w, h = 1920, 1080
    if tool and tool.Comp then
        local ok, v = pcall(function() return tool.Comp:GetPrefs("Comp.FrameFormat.Width") end)
        if ok and tonumber(v) and tonumber(v) > 0 then
            w = math.floor(tonumber(v) + 0.5)
        end
        ok, v = pcall(function() return tool.Comp:GetPrefs("Comp.FrameFormat.Height") end)
        if ok and tonumber(v) and tonumber(v) > 0 then
            h = math.floor(tonumber(v) + 0.5)
        end
    end
    return math.max(1, w), math.max(1, h)
end

local function makeImage(doc, w, h, quality)
    w = math.max(1, math.floor(w + 0.5))
    h = math.max(1, math.floor(h + 0.5))
    local attrs = {
        IMG_Width = w,
        IMG_Height = h,
        IMG_XScale = 1.0,
        IMG_YScale = 1.0,
        IMAT_OriginalWidth = w,
        IMAT_OriginalHeight = h,
        IMG_Depth = 8,
        IMG_Quality = quality and true or false,
        IMG_MotionBlurQuality = false,
        { IMG_Channel = "Red" },
        { IMG_Channel = "Green" },
        { IMG_Channel = "Blue" },
        { IMG_Channel = "Alpha" },
    }
    if doc then attrs.IMG_Document = doc end
    local ok, img = pcall(Image, attrs)
    if not ok then
        dbg("Image() threw:", tostring(img))
        return nil
    end
    if not img then
        dbg("Image() returned nil for", w, "x", h, "doc=", tostring(doc ~= nil))
    end
    return img
end

local function clearImage(img)
    img:Fill(Pixel(TRANSPARENT))
end

local function copyImage(img)
    local ok, out = pcall(function() return img:CopyOf() end)
    if ok and out then return out end
    ok, out = pcall(function() return img:Copy() end)
    if ok and out then return out end
    return img
end

local fontsScanned = false
local function scanFonts()
    if fontsScanned then return end
    pcall(function()
        if FontManager then
            local list = FontManager:GetFontList()
            if list == nil or next(list) == nil then
                FontManager:ScanDir()
            end
        end
    end)
    fontsScanned = true
end

local function readMetric(tfm, key, default)
    local ok, v = pcall(function() return tfm[key] end)
    if ok and tonumber(v) ~= nil then return tonumber(v) end
    return default
end

local function makeMetrics(fontName, fontStyle, sizePx)
    scanFonts()
    local candidates = {}
    if fontName and fontName ~= "" then
        candidates[#candidates + 1] = { fontName, fontStyle or "Regular" }
        candidates[#candidates + 1] = { fontName, "Regular" }
    end
    candidates[#candidates + 1] = { "Arial", "Regular" }
    candidates[#candidates + 1] = { "Helvetica", "Regular" }
    candidates[#candidates + 1] = { "Verdana", "Regular" }

    local tfm = nil
    local usedName, usedStyle
    for i = 1, #candidates do
        local name, style = candidates[i][1], candidates[i][2]
        local ok, font = pcall(function() return TextStyleFont(name, style) end)
        if ok and font then
            local ok2, metrics = pcall(function() return TextStyleFontMetrics(font) end)
            if ok2 and metrics then
                tfm = metrics
                usedName, usedStyle = name, style
                break
            end
        end
    end
    if not tfm then return nil end

    local tfmScale = readMetric(tfm, "Scale", 1)
    if tfmScale == 0 then tfmScale = 1 end

    local ascent = math.abs(readMetric(tfm, "TextAscent", 0.08)) * 10 * sizePx
    local descent = math.abs(readMetric(tfm, "TextDescent", 0.02)) * 10 * sizePx
    local leading = math.abs(readMetric(tfm, "TextExternalLeading", 0)) * 10 * sizePx
    if ascent + descent < 1 then
        ascent, descent, leading = sizePx * 0.8, sizePx * 0.2, 0
    end

    local cache = {}
    local function advance(cp)
        local v = cache[cp]
        if v ~= nil then return v end
        local ok, r = pcall(function() return tfm:CharacterWidth(cp) end)
        v = (ok and tonumber(r)) or 0
        if v < 0 then v = 0 end
        v = v * 10 * sizePx
        cache[cp] = v
        return v
    end
    local function kern(a, b)
        local ok, r = pcall(function() return tfm:CharacterKerning(a, b) end)
        local v = (ok and tonumber(r)) or 0
        return v * 10 * sizePx
    end

    return {
        advance = advance,
        kern = kern,
        ascentPx = ascent,
        descentPx = descent,
        lineGapPx = leading,
        tfm = tfm,
        tfmScale = tfmScale,
        fontName = usedName,
        fontStyle = usedStyle,
    }
end

local function rotPoint(x, y, degrees)
    if degrees == 0 then return x, y end
    local r = math.rad(degrees)
    local c, s = math.cos(r), math.sin(r)
    return x * c - y * s, x * s + y * c
end

local reportedGlyphError = false
local reportedGlyphNil = false

-- Splits a pixel coordinate into a whole-pixel cell origin and the remaining
-- sub-pixel offset.
--
-- A glyph cell is an integer-sized image, so it can only be composited at a
-- whole-pixel origin.  The old code rounded the target position to the nearest
-- pixel and drew the glyph at the cell centre, which discarded the remainder.
-- At the end of an eased move the per-frame displacement falls below one
-- pixel, so the glyph alternated between moving 1 px and 0 px and the motion
-- looked choppy.  Keeping the remainder and drawing the glyph at that offset
-- inside the cell preserves the exact float position, and the shape
-- rasteriser anti-aliases it.
function E.cellSplit(v)
    v = tonumber(v) or 0
    local i = math.floor(v)
    local frac = v - i
    if not (frac >= 0 and frac < 1) then frac = 0 end
    return i, frac
end

-- Creates a transformed glyph shape in a coordinate space where both axes are
-- normalised by coordW (Fusion's Shape convention).
--
-- The Fuse manual's text example scales by 1/tfm.Scale then by `size`, but its
-- `size` is *normalised* (about 0.1), not pixels.  Our Size control is in
-- pixels, so the equivalent normalised size is fontPx / coordW:
--
--     em = (fontPx * scale / coordW) / tfmScale
--
-- Dividing by coordW is required.  1.0.6 briefly removed it on the assumption
-- that the manual used pixels; the GUI showed solid squares during the
-- animation and a completely white frame when settled, i.e. glyphs covering
-- the frame because they were ~1920x too large.  1.0.9 restores the division.
local function glyphShape(cp, fontPx, scale, coordW, posX, posY, rotationDeg, tfm, tfmScale)
    local ok, sh = pcall(function() return tfm:GetCharacterShape(cp, false) end)
    if not ok then
        if not reportedGlyphError then
            reportedGlyphError = true
            dbg("render: GetCharacterShape failed for cp", tostring(cp), ":", tostring(sh))
        end
        return nil
    end
    if not sh then
        if not reportedGlyphNil then
            reportedGlyphNil = true
            dbg("render: GetCharacterShape returned nil for cp", tostring(cp))
        end
        return nil
    end
    if tfmScale == 0 then tfmScale = 1 end
    local mat = Matrix4()
    local em = (fontPx * scale / coordW) / tfmScale
    mat:Scale(em, em, 1)
    if rotationDeg ~= 0 then
        local pivot = 0.35 * fontPx * scale / coordW
        mat:Move(0, -pivot, 0)
        mat:RotZ(rotationDeg)
        mat:Move(0, pivot, 0)
    end
    mat:Move(posX / coordW, posY / coordW, 0)
    return sh:TransformOfShape(mat)
end

local function makeOutline(sh, thicknessPx, coordW)
    if thicknessPx <= 0 then return nil end
    local ok, out = pcall(function()
        return sh:OutlineOfShape(thicknessPx / coordW, "OLT_Solid", "OJT_Bevel", 8, "SWM_Normal", 8)
    end)
    if ok then return out end
    return nil
end

local function drawShape(img, sh, r, g, b, a, sampling, copyMode)
    if not sh then return false end
    a = E.clamp(tonumber(a) or 0, 0, 1)
    -- Fusion images are premultiplied: RGB may never exceed alpha.  The shape
    -- rasteriser writes the colour channels through unchanged, which is why a
    -- fade only changed alpha while RGB stayed at full white - the layer was
    -- then added on top and every letter popped in at full brightness.  Fade
    -- must be visible, so premultiply the colour we hand to the rasteriser.
    -- This is also what an alpha-aware Over expects, and it keeps the fade
    -- working even if the host only accepts the additive Merge fallback.
    local ic = ImageChannel(img, sampling)
    local fs = FillStyle()
    ic:SetStyleFill(fs)
    ic:ShapeFill(sh)
    local cs = ChannelStyle()
    cs.Color = Pixel({ R = r * a, G = g * a, B = b * a, A = a })
    ic:PutToImage(copyMode or "CM_Merge", cs)
    return true
end

local function blurImage(img, px, width)
    if px <= 0.01 or width <= 0 then return img end
    local opts = {
        BLUR_Type = "Gaussian",
        BLUR_Red = true,
        BLUR_Green = true,
        BLUR_Blue = true,
        BLUR_Alpha = true,
        BLUR_XSize = px / width,
        BLUR_YSize = px / width,
        BLUR_Blend = 1.0,
        -- The manual defines BLUR_Normalize as "1.0 - glow".  Zero therefore
        -- means full Glow: the blurred image is added back on top, inflating
        -- alpha (observed maxA 14.9 to 3752 instead of <= 1) and making the
        -- letters look very thick during the entrance.  1.0 is a plain blur.
        BLUR_Normalize = 1.0,
        BLUR_Passes = 0.0,
    }
    local ok, out = pcall(function()
        local dest = Image({ IMG_Like = img })
        local res = img:Blur(dest, opts)
        return res or dest
    end)
    if ok and out then return out end
    ok, out = pcall(function() return img:Blur(nil, opts) end)
    if ok and out then return out end
    ok, out = pcall(function() return img:Blur(img, opts) end)
    if ok and out then return out end
    return img
end

--===========================================================================
-- PART 4 - PROCESS
--===========================================================================

local warnedFont = false

local function readParams(req)
    local px, py = getPoint(InPosition, req, 0.5, 0.5)
    return {
        mode = getNum(InAnimMode, req, 0),
        sequenceMode = getNum(InSequence, req, 0),
        order = getNum(InOrder, req, 0),
        seed = getNum(InSeed, req, 12345),
        startFrame = getNum(InStartFrame, req, 0),
        exitStart = getNum(InExitStart, req, 72),
        speed = getNum(InSpeed, req, 1),
        inDuration = getNum(InDuration, req, 12),
        inStagger = getNum(InStagger, req, 2),
        outDuration = getNum(InOutDuration, req, 12),
        outStagger = getNum(InOutStagger, req, 2),
        inTotal = getNum(InInTotal, req, 60),
        outTotal = getNum(InOutTotal, req, 60),
        fitIn = getNum(InFitIn, req, 0),
        fitOut = getNum(InFitOut, req, 0),
        direction = getNum(InDirection, req, 1),
        distance = getNum(InDistance, req, 40),
        settle = getNum(InSettle, req, 1),
        scaleIn = getNum(InScaleIn, req, 100) / 100,
        scaleOut = getNum(InScaleOut, req, 100) / 100,
        rotationIn = getNum(InRotation, req, 0),
        rotationOut = getNum(InRotationOut, req, 0),
        trackingIn = getNum(InTrackingIn, req, 0),
        trackingOut = getNum(InTrackingOut, req, 0),
        intensity = getNum(InMasterIntensity, req, 1),
        easingIn = getNum(InEaseIn, req, E.EASE_DEFAULT),
        easingOut = getNum(InEaseOut, req, E.EASE_DEFAULT_OUT),
        elasticCycles = getNum(InElasticCycles, req, E.ELASTIC_CYCLES),
        elasticDamping = getNum(InElasticDamping, req, E.ELASTIC_DAMPING),
        fade = getNum(InFade, req, 1),
        blur = getNum(InBlur, req, 1),
        blurAmount = getNum(InBlurAmount, req, 12),
        maxBlur = getNum(InMaxBlur, req, 120),
        size = getNum(InSize, req, 96),
        tracking = getNum(InTracking, req, 0),
        lineSpacing = getNum(InLineSpacing, req, 1),
        align = getNum(InAlign, req, 1),
        valign = getNum(InVAlign, req, 1),
        posX = px,
        posY = py,
        opacity = getNum(InOpacity, req, 1),
        masterScale = getNum(InMasterScale, req, 1),
        masterRotation = getNum(InMasterRotation, req, 0),
        textR = getNum(InTextR, req, 1),
        textG = getNum(InTextG, req, 1),
        textB = getNum(InTextB, req, 1),
        textA = getNum(InTextA, req, 1),
        outline = getNum(InOutline, req, 0),
        outlineThickness = getNum(InOutlineThickness, req, 2),
        outlineR = getNum(InOutlineR, req, 0),
        outlineG = getNum(InOutlineG, req, 0),
        outlineB = getNum(InOutlineB, req, 0),
        outlineA = getNum(InOutlineA, req, 1),
        testFrame = getNum(InTestFrame, req, 0) >= 0.5,
    }
end

local function isQuick(req)
    local ok, q = pcall(function() return req:IsQuick() end)
    if ok then return q and true or false end
    return false
end

local function emptyOutput(req, tool, bg, W, H, quality)
    if bg then
        dbg("emptyOutput: passing background through", W, "x", H)
        OutImage:Set(req, copyImage(bg))
        return
    end
    local out = makeImage(tool and tool.Comp, W, H, quality)
    if not out then
        error("Image() returned nil for the empty output")
    end
    clearImage(out)
    local full, why = ensureFullDataWindow(out, W, H)
    dbg("emptyOutput: data window", tostring(full), "(" .. tostring(why) .. ")")
    dbg("emptyOutput: transparent image set", W, "x", H)
    OutImage:Set(req, out)
end

-- The final composite goes through the host's FFI image binding, whose
-- attribute mapping differs between builds.  The manual states that
-- MO_ApplyMode = "Merge" (and an empty table) performs an *additive* merge:
-- the foreground is added over the background and the alpha falloff is lost.
-- That is what made every fade pop in at full brightness.  "Normal" is the
-- alpha-aware Over.  It is tried first, with the documented alternatives as
-- logged fallbacks.  On Resolve 21.0.4 {"Normal", "Over"} once raised
--   bad argument #3 to 'func' (cannot convert 'nil' to 'int')
-- so "Normal" alone is attempted before any operator variant.
local function compositeLayer(out, layer)
    local strategies = {
        {
            name = "Normal",
            run = function()
                out:Merge(layer, { MO_ApplyMode = "Normal" })
            end,
        },
        {
            name = "Normal+Over",
            run = function()
                out:Merge(layer, { MO_ApplyMode = "Normal", MO_ApplyOperator = "Over" })
            end,
        },
        {
            name = "Merge",
            run = function()
                out:Merge(layer, { MO_ApplyMode = "Merge" })
            end,
        },
        {
            name = "Merge+Over",
            run = function()
                out:Merge(layer, { MO_ApplyMode = "Merge", MO_ApplyOperator = "Over" })
            end,
        },
        {
            name = "empty (additive)",
            run = function()
                out:Merge(layer, {})
            end,
        },
        {
            name = "OMerge",
            run = function()
                out:OMerge(layer, 0, 0)
            end,
        },
        {
            name = "BlendOf",
            run = function()
                local merged = out:BlendOf(layer, 1.0)
                if merged then out = merged end
            end,
        },
        {
            name = "MergeOf",
            run = function()
                local merged = out:MergeOf(layer, { MO_ApplyMode = "Merge" })
                if merged then out = merged end
            end,
        },
    }
    for _, strategy in ipairs(strategies) do
        local ok, err = pcall(strategy.run)
        if ok then
            dbg("render: layer composite ok via", strategy.name)
            return out
        end
        dbg("render: layer composite failed via", strategy.name, ":", tostring(err))
    end
    dbg("render: every layer composite strategy failed")
    return out
end

-- Animated glyphs are drawn into small cells and then placed onto the text
-- layer.  OMerge is additive: where two cells overlap, their RGB and alpha add,
-- which looks like thick, over-bright letters with black patches when alpha
-- exceeds 1.  Merge is alpha-aware, but its position attributes are NOT pixel
-- offsets like OMerge's: MO_XOffset/MO_YOffset are the foreground centre in
-- normalised image coordinates (0,0 bottom left; 0.5,0.5 centre; 1,1 top
-- right).  Passing pixel values put every cell far outside the frame, so the
-- animation became invisible and letters only appeared when they settled into
-- the static shape.  Convert the cell's pixel bounds to a normalised centre.
local loggedCellStrategies = {}

local function mergeCellAt(layer, cell, x, y)
    local W = tonumber(layer and layer.Width) or 1
    local H = tonumber(layer and layer.Height) or 1
    local cw = tonumber(cell and cell.Width) or 0
    local ch = tonumber(cell and cell.Height) or 0
    local cx = (x + cw / 2) / W
    local cy = (y + ch / 2) / H

    local attempts = {
        {
            name = "Normal+centre",
            run = function()
                layer:Merge(cell, {
                    MO_ApplyMode = "Normal",
                    MO_XOffset = cx,
                    MO_YOffset = cy,
                    MO_XAxis = 0.5,
                    MO_YAxis = 0.5,
                })
            end,
        },
        {
            name = "Normal+Over+centre",
            run = function()
                layer:Merge(cell, {
                    MO_ApplyMode = "Normal",
                    MO_ApplyOperator = "Over",
                    MO_XOffset = cx,
                    MO_YOffset = cy,
                    MO_XAxis = 0.5,
                    MO_YAxis = 0.5,
                })
            end,
        },
        {
            name = "Merge+centre",
            run = function()
                layer:Merge(cell, {
                    MO_ApplyMode = "Merge",
                    MO_XOffset = cx,
                    MO_YOffset = cy,
                    MO_XAxis = 0.5,
                    MO_YAxis = 0.5,
                })
            end,
        },
        {
            name = "OMerge",
            run = function()
                layer:OMerge(cell, x, y)
            end,
        },
    }
    for _, a in ipairs(attempts) do
        local ok, err = pcall(a.run)
        if ok then
            if not loggedCellStrategies[a.name] then
                loggedCellStrategies[a.name] = true
                dbg("render: animated cell composite via", a.name,
                    string.format("centre= %.4f,%.4f (%.1f,%.1f px)", cx, cy, x, y))
            end
            return true
        end
        if not loggedCellStrategies[a.name] then
            loggedCellStrategies[a.name] = true
            dbg("render: animated cell composite failed via", a.name, ":", tostring(err))
        end
    end
    return false
end

local function renderText(req, tool)
    local p = E.sanitizeParams(readParams(req))
    local bg = getImage(InBackground, req)
    dbg("render: frame=", tostring(req and req.Time),
        "bg=", bg and (tostring(bg.Width) .. "x" .. tostring(bg.Height)) or "nil")
    local W, H
    if bg and tonumber(bg.Width) and tonumber(bg.Height)
        and tonumber(bg.Width) > 0 and tonumber(bg.Height) > 0 then
        W = math.floor(tonumber(bg.Width) + 0.5)
        H = math.floor(tonumber(bg.Height) + 0.5)
    else
        W, H = compSize(tool)
        bg = nil
    end
    local quick = isQuick(req)
    local quality = not quick
    local sampling = quick and 1 or 32
    dbg("render: size=", W, "x", H, "quick=", tostring(quick))

    -- Diagnostic bypass: proves that Process() runs and that this Fuse can
    -- deliver a full-frame image, without touching any text or shape code.
    if p.testFrame then
        local testOut = makeImage(tool and tool.Comp, W, H, quality)
        if not testOut then
            error("Image() returned nil for the diagnostic frame")
        end
        testOut:Fill(Pixel({ R = 1, G = 0, B = 1, A = 1 }))
        describeImage("render: diagnostic frame", testOut)
        OutImage:Set(req, testOut)
        dbg("render: diagnostic solid frame set")
        return
    end

    local text = getText(InText, req, "")
    if text == "" then
        dbg("render: empty text")
        emptyOutput(req, tool, bg, W, H, quality)
        return
    end

    local fontSize = p.size * p.masterScale
    local metrics = makeMetrics(getText(InFont, req, "Arial"), getText(InFontStyle, req, "Regular"), fontSize)
    if not metrics then
        if not warnedFont then
            warnedFont = true
            print("[Text Animator] Could not load a font. Please choose an installed font in the Text section.")
        end
        dbg("render: no font metrics")
        emptyOutput(req, tool, bg, W, H, quality)
        return
    end
    dbg("render: font=", metrics.fontName, metrics.fontStyle,
        "size=", fontSize,
        "ascent=", metrics.ascentPx, "descent=", metrics.descentPx,
        "scale=", metrics.tfmScale)

    local layout = E.layout(text, {
        sizePx = fontSize,
        trackingPx = p.tracking * p.masterScale,
        lineSpacing = p.lineSpacing,
        align = p.align,
        valign = p.valign,
    }, metrics)

    if #layout.glyphs == 0 then
        dbg("render: layout produced no glyphs")
        emptyOutput(req, tool, bg, W, H, quality)
        return
    end

    local segments = E.buildSegments(layout, p.sequenceMode)
    if #segments == 0 then
        dbg("render: no segments")
        emptyOutput(req, tool, bg, W, H, quality)
        return
    end
    dbg("render: glyphs=", #layout.glyphs, "segments=", #segments,
        "sequence=", p.sequenceMode, "mode=", p.mode)
    local gFirst = layout.glyphs[1]
    local gLast = layout.glyphs[#layout.glyphs]
    dbg("render: glyph layout first=",
        gFirst and string.format("%.1f,%.1f", gFirst.xPx, gFirst.baselinePx) or "nil",
        "last=", gLast and string.format("%.1f,%.1f", gLast.xPx, gLast.baselinePx) or "nil")

    local ranks = E.computeRanks(#segments, p.order, p.seed)
    local timing = E.computeTiming(p, #segments)
    local frame = math.floor((tonumber(req.Time) or 0) + 0.5)
    local t = (frame - p.startFrame) * p.speed
    local states = {}
    for i = 1, #segments do
        states[i] = E.evaluateSegment(p, t, ranks[i], timing)
    end

    local anchorX = p.posX * W
    local anchorY = p.posY * H
    local rot = p.masterRotation
    dbg("render: anchor=", string.format("%.1f,%.1f", anchorX, anchorY),
        "rotation=", rot, "masterScale=", p.masterScale)

    local out
    if bg then
        out = copyImage(bg)
    else
        out = makeImage(tool and tool.Comp, W, H, quality)
        if not out then
            error("Image() returned nil for the output image")
        end
        clearImage(out)
        local full, why = ensureFullDataWindow(out, W, H)
        dbg("render: out data window", tostring(full), "(" .. tostring(why) .. ")")
    end
    describeImage("render: out before text", out)

    -- The text is built in a transparent full-frame layer so that it can be
    -- composited over the background with a proper Over, rather than an
    -- additive merge.
    local layer = makeImage(tool and tool.Comp, W, H, quality)
    if not layer then
        error("Image() returned nil for the text layer")
    end
    clearImage(layer)
    local layerFull, layerWhy = ensureFullDataWindow(layer, W, H)
    dbg("render: layer data window", tostring(layerFull), "(" .. tostring(layerWhy) .. ")")
    describeImage("render: layer before text", layer)

    local textAlpha = p.textA * p.opacity
    local staticCount = 0
    local cellCount = 0

    -- Fast path: all settled glyphs are drawn in one shape.
    local fillShape = Shape()
    local outlineShape = Shape()
    local hasStatic = false
    for i = 1, #layout.glyphs do
        local g = layout.glyphs[i]
        if g.segment and not g.isSpace then
            local st = states[g.segment]
            if not st.animating and E.isFinalState(st) then
                local rx, ry = rotPoint(g.xPx + E.trackShift(g, st.tracking or 0),
                    g.baselinePx, rot)
                local sh = glyphShape(g.cp, fontSize, 1, W,
                    anchorX + rx, anchorY + ry, rot, metrics.tfm, metrics.tfmScale)
                if sh then
                    fillShape:AddShape(sh)
                    if p.outline and p.outlineThickness > 0 then
                        local o = makeOutline(sh, p.outlineThickness * p.masterScale, W)
                        if o then outlineShape:AddShape(o) end
                    end
                    hasStatic = true
                    staticCount = staticCount + 1
                end
            end
        end
    end

    if hasStatic and (textAlpha > 0
        or (p.outline and p.outlineThickness > 0 and p.outlineA * p.opacity > 0)) then
        if p.outline and p.outlineThickness > 0 and p.outlineA * p.opacity > 0 then
            drawShape(layer, outlineShape, p.outlineR, p.outlineG, p.outlineB,
                p.outlineA * p.opacity, sampling, "CM_Merge")
        end
        if textAlpha > 0 then
            drawShape(layer, fillShape, p.textR, p.textG, p.textB,
                textAlpha, sampling, "CM_Merge")
        end
    end
    dbg("render: static glyphs=", staticCount, "textAlpha=", textAlpha,
        "outline=", tostring(p.outline and p.outlineThickness > 0))

    -- Animated segments are rendered into small cells, blurred, and added
    -- into the text layer.  Cells keep per-segment blur affordable.
    if p.opacity > 0 and (textAlpha > 0
        or (p.outline and p.outlineThickness > 0 and p.outlineA > 0)) then
        for si = 1, #segments do
            local st = states[si]
            if E.needsCell(st) then
                local seg = segments[si]
                local blurPx = math.min(st.blur, p.maxBlur)
                local margin = math.ceil(blurPx * 2.5 + fontSize * 0.12) + 4
                if margin > 600 then margin = 600 end
                local scaleMax = math.max(1, st.scale)
                -- Master rotation and the segment's own spin both need the
                -- larger square cell so a rotated glyph cannot be clipped.
                local cellRotation = rot + (st.rotation or 0)
                local rotatedCell = (cellRotation ~= 0)

                for gi = 1, #seg.glyphs do
                    local g = seg.glyphs[gi]
                    if not g.isSpace then
                        local cellW = math.max(g.advancePx * scaleMax, fontSize * 0.7 * scaleMax)
                            + margin * 2
                        local cellH = (metrics.ascentPx + metrics.descentPx) * scaleMax + margin * 2
                        if rotatedCell then
                            -- The square must also contain the glyph when it
                            -- turns about its pivot, which sits slightly off
                            -- the cell centre.  The extra 0.7 em covers that
                            -- offset at any angle.
                            local diag = math.ceil(math.sqrt(cellW * cellW + cellH * cellH)
                                + fontSize * scaleMax * 0.7) + 2
                            cellW, cellH = diag, diag
                        end
                        cellW = math.max(1, math.ceil(cellW))
                        cellH = math.max(1, math.ceil(cellH))
                        local rx, ry = rotPoint(g.xPx + E.trackShift(g, st.tracking or 0),
                            g.baselinePx, rot)
                        local centerX = anchorX + rx + st.dx
                        local baselineY = anchorY + ry + st.dy
                        local fromBottom
                        if rotatedCell then
                            fromBottom = cellH / 2
                        else
                            fromBottom = margin + metrics.descentPx * scaleMax
                        end
                        -- Whole-pixel origin plus the sub-pixel remainder.
                        -- The remainder is drawn into the cell, so the glyph
                        -- lands on its exact float position and eased motion
                        -- stays smooth instead of stepping once per pixel.
                        local left, subX = E.cellSplit(centerX - cellW / 2)
                        local bottom, subY = E.cellSplit(baselineY - fromBottom)

                        if not (left + cellW <= 0 or left >= W
                            or bottom + cellH <= 0 or bottom >= H) then
                            local cell = makeImage(tool and tool.Comp, cellW, cellH, quality)
                            if not cell then
                                error("Image() returned nil for an animated glyph cell")
                            end
                            clearImage(cell)

                            local sh = glyphShape(g.cp, fontSize, st.scale, cellW,
                                cellW / 2 + subX, fromBottom + subY, cellRotation,
                                metrics.tfm, metrics.tfmScale)
                            if sh then
                                local drew = false
                                if p.outline and p.outlineThickness > 0 then
                                    local o = makeOutline(sh, p.outlineThickness * p.masterScale, cellW)
                                    if o then
                                        drew = drawShape(cell, o, p.outlineR, p.outlineG, p.outlineB,
                                            p.outlineA * p.opacity * st.alpha, sampling, "CM_Copy") or drew
                                    end
                                end
                                if drawShape(cell, sh, p.textR, p.textG, p.textB,
                                        textAlpha * st.alpha, sampling,
                                        (p.outline and p.outlineThickness > 0) and "CM_Merge" or "CM_Copy") or drew then
                                    local blurred = blurImage(cell, blurPx, cellW)
                                    if cellCount == 0 then
                                        dbg("render: first cell",
                                            string.format("bounds= %d,%d %dx%d sub= %.3f,%.3f alpha= %.3f dx= %.2f dy= %.2f scale= %.3f rot= %.2f track= %.2f blur= %.2f",
                                                left, bottom, cellW, cellH, subX, subY,
                                                textAlpha * st.alpha, st.dx, st.dy, st.scale,
                                                st.rotation or 0, st.tracking or 0, blurPx))
                                    end
                                    mergeCellAt(layer, blurred, left, bottom)
                                    cellCount = cellCount + 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    dbg("render: animated cells=", cellCount)
    local hit, total, maxA, maxR, maxG, maxB = alphaCoverage(layer)
    dbg("render: layer coverage=", hit, "/", total, "maxA=", maxA,
        string.format("RGB= %.3f,%.3f,%.3f", maxR, maxG, maxB))
    dbg("render: compositing text layer")
    out = compositeLayer(out, layer)
    describeImage("render: out after merge", out)
    local ohit, ototal, omax, omaxR, omaxG, omaxB = alphaCoverage(out)
    dbg("render: out coverage=", ohit, "/", ototal, "maxA=", omax,
        string.format("RGB= %.3f,%.3f,%.3f", omaxR, omaxG, omaxB))
    OutImage:Set(req, out)
    dbg("render: output set")
end

local reportedTraceback = false

function Process(req)
    dbg("Process enter: time=", tostring(req and req.Time),
        "comp=", tostring(self ~= nil and self.Comp ~= nil),
        "out=", tostring(OutImage ~= nil),
        "globals=", tostring(Width), "x", tostring(Height))

    if not OutImage then
        dbg("Process: OutImage is nil - Create() did not run")
        return
    end

    local ok, err = pcall(renderText, req, self)
    if ok then
        dbg("Process: done")
        return
    end

    dbg("Process: render error:", tostring(err))
    if not reportedTraceback then
        reportedTraceback = true
        pcall(function() dbg("Process: traceback:", debug.traceback("", 2)) end)
    end

    local tool = self or {}
    local bg = nil
    pcall(function() bg = getImage(InBackground, req) end)
    local W, H = compSize(tool)
    if bg and tonumber(bg.Width) and tonumber(bg.Height) then
        W = math.floor(tonumber(bg.Width) + 0.5)
        H = math.floor(tonumber(bg.Height) + 0.5)
    end

    local ok2, err2 = pcall(emptyOutput, req, tool, bg, W, H, not isQuick(req))
    if ok2 then
        dbg("Process: fallback empty output set")
        return
    end
    dbg("Process: fallback error:", tostring(err2))

    -- Last resort: the smallest documented image, so the downstream node at
    -- least receives a valid parameter instead of a failed render.
    local ok3, err3 = pcall(function()
        local minimal = Image({ IMG_Width = W, IMG_Height = H })
        if minimal then
            minimal:Fill(Pixel({ R = 0, G = 0, B = 0, A = 0 }))
        end
        OutImage:Set(req, minimal)
    end)
    if ok3 then
        dbg("Process: minimal image set")
    else
        dbg("Process: last resort error:", tostring(err3))
    end
end

dbg("fuse loaded: Text Animator " .. E.VERSION .. " (REG_Version 121)")
