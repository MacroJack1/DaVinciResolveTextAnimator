--[[--
    Text Animator
    A native DaVinci Resolve / Fusion Fuse.

    Animates text per character, word or line entirely inside a Fuse.
    No Text+ node chaining and no macro is used.

    Target: DaVinci Resolve 21.1.1 (Fusion 21), macOS / Windows / Linux.
    Version: 1.1.11
    License: MIT (see LICENSE in the project folder)

    IMPORTANT
    ---------
    This file contains two parts:

      1. TextAnimatorEngine - a pure Lua engine. It performs UTF-8 decoding,
         layout, segmentation, ordering, timing and easing. It is deliberately
         free of Fusion calls so it can be unit tested outside of Resolve.
         It is exposed as the global TextAnimatorEngine.

      2. The Fuse wrapper (Create / NotifyChanged / Process) which uses the
         documented Fusion shape and text APIs to rasterise the result.

    The engine is tested outside Resolve. Rendering has to be verified in
    Resolve because the development machine used for this build cannot run
    Fusion headlessly or automate the Resolve GUI. See docs/TestReport.md
    for exactly what was verified and what was not.
--]]--

FuRegisterClass("TextAnimator", CT_Tool, {
    REGS_Name = "Text Animator",
    REGS_Category = "Fuses\\Text",
    REGS_OpIconString = "TxA",
    REGS_OpDescription = "Per-character, word and line text animation with native Fuse rendering",
    REGS_HelpTopic = "Text Animator - Fuses\\Text",
    REG_Version = 121,
    REG_TimeVariant = true,
    REG_NoBlendCtrls = true,
    REG_NoObjMatCtrls = true,
    REG_NoMotionBlurCtrls = true,
    REG_OpNoMask = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

--===========================================================================
-- PART 0 - DIAGNOSTICS
--
-- This block must be defined before Create() and before the engine, because
-- the diagnostics are used while the Fuse file is being loaded and while the
-- tool is being built.  In Lua a local is only visible after its declaration,
-- so keeping this block further down the file would make Create() call a nil
-- global instead of dbg().
--
-- Every message is prefixed with "[Text Animator]" so it can be copied out of
-- the Fusion console.  The same text is mirrored to a log file when Lua's io
-- library is available in the host.  DEBUG is switched off once the render
-- path has been verified in Resolve.
--===========================================================================

local DEBUG = true

local logFilePath = nil
local logFileHandle = nil
local function logWrite(msg)
    if logFilePath == false then return end
    if not logFilePath then
        local candidates = {}
        local home = os.getenv("HOME")
        if home then
            candidates[#candidates + 1] =
                home .. "/Library/Application Support/Fusion/TextAnimator-debug.log"
        end
        local tmp = os.getenv("TMPDIR")
        if tmp then
            candidates[#candidates + 1] = tmp .. "/TextAnimator-debug.log"
        end
        candidates[#candidates + 1] = "/tmp/TextAnimator-debug.log"
        for i = 1, #candidates do
            local ok, f = pcall(io.open, candidates[i], "a")
            if ok and f then
                logFilePath = candidates[i]
                logFileHandle = f
                break
            end
        end
        logFilePath = logFilePath or false
    end
    if logFileHandle then
        pcall(function()
            logFileHandle:write(os.date("%H:%M:%S ") .. msg .. "\n")
            logFileHandle:flush()
        end)
    end
end

local function dbg(...)
    if not DEBUG then return end
    local parts = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = tostring((select(i, ...)))
    end
    local msg = table.concat(parts, " ")
    pcall(print, "[Text Animator] " .. msg)
    logWrite(msg)
end

--===========================================================================
-- PART 1 - PURE ENGINE
--===========================================================================

local E = {}
TextAnimatorEngine = E

E.VERSION = "1.1.11"

E.MODE_IN_OUT = 0
E.MODE_IN_ONLY = 1
E.MODE_OUT_ONLY = 2
E.MODE_NONE = 3

E.SEQ_CHARACTER = 0
E.SEQ_WORD = 1
E.SEQ_LINE = 2

E.ORDER_FORWARD = 0
E.ORDER_REVERSE = 1
E.ORDER_CENTER_OUT = 2
E.ORDER_OUTSIDE_IN = 3
E.ORDER_RANDOM = 4

E.ALIGN_LEFT = 0
E.ALIGN_CENTER = 1
E.ALIGN_RIGHT = 2

E.VALIGN_TOP = 0
E.VALIGN_MIDDLE = 1
E.VALIGN_BOTTOM = 2

-- Order must match the ComboControl entries in buildControls() and E.ease().
E.EASING_NAMES = {
    "Linear", "Cubic In", "Cubic Out", "Cubic In Out",
    "Elastic In", "Elastic Out", "Back In", "Back Out",
    "Bounce Out", "Expo In", "Expo Out", "Sine In Out",
}
E.EASE_DEFAULT = 2 -- Cubic Out: the default entrance curve.
E.EASE_DEFAULT_OUT = 3 -- Cubic In Out: the default exit curve.
E.EASE_MAX = #E.EASING_NAMES - 1

-- Elastic shape.  More cycles than Back so the two curves read differently:
-- Back makes one soft overshoot, Elastic keeps wobbling.  The time warp slows
-- the phase at the start, which keeps the first frames of a 12-frame entrance
-- from consuming most of the move while still fitting several oscillations in.
E.ELASTIC_CYCLES = 2.5
E.ELASTIC_DAMPING = 7
E.ELASTIC_MIN_CYCLES = 1
E.ELASTIC_MAX_CYCLES = 4
E.ELASTIC_MIN_DAMPING = 2
E.ELASTIC_MAX_DAMPING = 20
E.ELASTIC_TIME_WARP = 1.8

-- Per-segment entrance/exit rotation is in degrees.  +/-720 allows two full
-- turns in either direction; the slider's comfortable range is +/-180.
E.ROTATION_LIMIT = 720

E.DIRECTION_NAMES = {
    "None", "Up", "Down", "Left", "Right",
    "Up Left", "Up Right", "Down Left", "Down Right",
}

-- Entrance displacement vectors point from the final position towards the
-- place the segment starts.  Exit vectors point in the direction of travel.
-- Y is positive upwards, matching Fusion's image space.
E.DIRECTIONS = {
    [0] = { 0, 0, 0, 0 },
    [1] = { 0, -1, 0, 1 },     -- Up: enter from below, leave upwards
    [2] = { 0, 1, 0, -1 },     -- Down
    [3] = { 1, 0, -1, 0 },     -- Left: enter from the right
    [4] = { -1, 0, 1, 0 },     -- Right
    [5] = { 1, -1, -1, 1 },    -- Up Left
    [6] = { -1, -1, 1, 1 },    -- Up Right
    [7] = { 1, 1, -1, -1 },    -- Down Left
    [8] = { -1, 1, 1, -1 },    -- Down Right
}

function E.clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

function E.sanitizeNumber(v, default, lo, hi)
    v = tonumber(v)
    if v == nil then return default end
    if v ~= v then return default end
    if v == math.huge then return hi end
    if v == -math.huge then return lo end
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

function E.sanitizeInt(v, default, lo, hi)
    return math.floor(E.sanitizeNumber(v, default, lo, hi) + 0.5)
end

function E.sanitizeBool(v, default)
    if v == nil then return default and true or false end
    if type(v) == "boolean" then return v end
    local n = tonumber(v)
    if n == nil then return default and true or false end
    return n > 0.5
end

-----------------------------------------------------------------------------
-- UTF-8
-----------------------------------------------------------------------------

-- Returns an array of {cp=<codepoint>, start=<byte>, len=<bytes>}.
-- Invalid sequences become U+FFFD and consume one byte, so arbitrary binary
-- data cannot abort layout.
function E.utf8Decode(s)
    local out = {}
    local i = 1
    local n = #s
    while i <= n do
        local b = s:byte(i)
        local cp, len
        if b < 0x80 then
            cp, len = b, 1
        elseif b >= 0xC2 and b <= 0xDF then
            local b2 = s:byte(i + 1)
            if b2 and b2 >= 0x80 and b2 <= 0xBF then
                cp = (b - 0xC0) * 64 + (b2 - 0x80)
                len = 2
            else
                cp, len = 0xFFFD, 1
            end
        elseif b >= 0xE0 and b <= 0xEF then
            local b2, b3 = s:byte(i + 1), s:byte(i + 2)
            local ok = b2 and b3 and b2 >= 0x80 and b2 <= 0xBF
                and b3 >= 0x80 and b3 <= 0xBF
            if ok then
                if b == 0xE0 and b2 < 0xA0 then ok = false end
                if b == 0xED and b2 > 0x9F then ok = false end
            end
            if ok then
                cp = (b - 0xE0) * 4096 + (b2 - 0x80) * 64 + (b3 - 0x80)
                len = 3
            else
                cp, len = 0xFFFD, 1
            end
        elseif b >= 0xF0 and b <= 0xF4 then
            local b2, b3, b4 = s:byte(i + 1), s:byte(i + 2), s:byte(i + 3)
            local ok = b2 and b3 and b4
                and b2 >= 0x80 and b2 <= 0xBF
                and b3 >= 0x80 and b3 <= 0xBF
                and b4 >= 0x80 and b4 <= 0xBF
            if ok then
                if b == 0xF0 and b2 < 0x90 then ok = false end
                if b == 0xF4 and b2 > 0x8F then ok = false end
            end
            if ok then
                cp = (b - 0xF0) * 262144 + (b2 - 0x80) * 4096
                    + (b3 - 0x80) * 64 + (b4 - 0x80)
                len = 4
            else
                cp, len = 0xFFFD, 1
            end
        else
            cp, len = 0xFFFD, 1
        end
        out[#out + 1] = { cp = cp, start = i, len = len }
        i = i + len
    end
    return out
end

function E.isCombiningCp(cp)
    return (cp >= 0x0300 and cp <= 0x036F)
        or (cp >= 0x1AB0 and cp <= 0x1AFF)
        or (cp >= 0x1DC0 and cp <= 0x1DFF)
        or (cp >= 0x20D0 and cp <= 0x20FF)
        or (cp >= 0xFE20 and cp <= 0xFE2F)
        or (cp >= 0x0483 and cp <= 0x0489)
        or (cp >= 0x0591 and cp <= 0x05BD)
        or (cp >= 0x0610 and cp <= 0x061A)
        or (cp >= 0x064B and cp <= 0x065F)
        or (cp >= 0x0670 and cp <= 0x0670)
        or (cp >= 0x06D6 and cp <= 0x06DC)
        or (cp >= 0x0900 and cp <= 0x0903)
        or (cp >= 0x093A and cp <= 0x093C)
        or (cp >= 0x093E and cp <= 0x094F)
        or (cp >= 0x0E31 and cp <= 0x0E31)
        or (cp >= 0x0E34 and cp <= 0x0E3A)
end

function E.clusters(cps)
    local clusters = {}
    for i = 1, #cps do
        local item = cps[i]
        if E.isCombiningCp(item.cp) and #clusters > 0 then
            local c = clusters[#clusters]
            c.cps[#c.cps + 1] = item
        else
            clusters[#clusters + 1] = { cps = { item } }
        end
    end
    return clusters
end

function E.splitLines(text)
    text = tostring(text or "")
    local lines = {}
    local start = 1
    local i = 1
    while i <= #text do
        local b = text:byte(i)
        if b == 10 or b == 13 then
            lines[#lines + 1] = text:sub(start, i - 1)
            if b == 13 and text:byte(i + 1) == 10 then i = i + 1 end
            start = i + 1
        end
        i = i + 1
    end
    lines[#lines + 1] = text:sub(start)
    return lines
end

function E.isSpaceCp(cp)
    return cp == 32 or cp == 9 or cp == 0xA0
        or (cp >= 0x2000 and cp <= 0x200A)
        or cp == 0x202F or cp == 0x205F or cp == 0x3000
end

-----------------------------------------------------------------------------
-- Layout
-----------------------------------------------------------------------------

-- metrics must provide:
--   advance(codepoint) -> advance in output pixels
--   kern(prevCodepoint, codepoint) -> adjustment in output pixels
--   ascentPx, descentPx, lineGapPx
-- The supplied metrics are already scaled for the requested font size.
function E.layout(text, opts, metrics)
    opts = opts or {}
    if not metrics then error("metrics are required") end
    local tracking = opts.trackingPx or 0
    local lineSpacing = opts.lineSpacing or 1
    local align = opts.align or E.ALIGN_CENTER
    local valign = opts.valign or E.VALIGN_MIDDLE
    local sizePx = opts.sizePx or 32

    local ascent = metrics.ascentPx or (sizePx * 0.8)
    local descent = metrics.descentPx or (sizePx * 0.2)
    if ascent < 0 then ascent = -ascent end
    if descent < 0 then descent = -descent end
    local leading = metrics.lineGapPx or 0
    local lineHeight = (ascent + descent + leading) * lineSpacing
    if lineHeight < 1 then lineHeight = (ascent + descent) end
    if lineHeight < 1 then lineHeight = sizePx end

    local linesText = E.splitLines(text)
    local lines = {}
    local glyphs = {}
    local maxWidth = 0
    local clusterSeq = 0

    for li = 1, #linesText do
        local cps = E.utf8Decode(linesText[li])
        local clusters = E.clusters(cps)
        local pen = 0
        local prevCp = nil
        local lineGlyphs = {}
        for ci = 1, #clusters do
            local cluster = clusters[ci]
            local kern = 0
            if prevCp and metrics.kern then
                kern = tonumber(metrics.kern(prevCp, cluster.cps[1].cp)) or 0
            end
            pen = pen + kern
            clusterSeq = clusterSeq + 1
            for gi = 1, #cluster.cps do
                local cp = cluster.cps[gi].cp
                local adv = 0
                if metrics.advance then
                    adv = tonumber(metrics.advance(cp)) or 0
                end
                if adv < 0 then adv = 0 end
                local g = {
                    cp = cp,
                    line = li,
                    cluster = clusterSeq,
                    clusterInLine = ci,
                    clusterCount = #clusters,
                    xPx = pen + adv * 0.5,
                    advancePx = adv,
                    isSpace = E.isSpaceCp(cp),
                    baselinePx = 0,
                }
                glyphs[#glyphs + 1] = g
                lineGlyphs[#lineGlyphs + 1] = g
                pen = pen + adv
            end
            if ci < #clusters then pen = pen + tracking end
            prevCp = cluster.cps[#cluster.cps].cp
        end
        local lineWidth = pen
        if lineWidth > maxWidth then maxWidth = lineWidth end
        lines[#lines + 1] = {
            widthPx = lineWidth,
            glyphs = lineGlyphs,
            text = linesText[li],
            clusterCount = #clusters,
        }
    end

    local n = #linesText
    local blockH = 0
    if n > 0 then
        blockH = (n - 1) * lineHeight + ascent + descent
    end
    local anchorOff = 0
    if valign == E.VALIGN_TOP then
        anchorOff = -blockH / 2
    elseif valign == E.VALIGN_BOTTOM then
        anchorOff = blockH / 2
    end
    local firstBase = anchorOff + blockH / 2 - ascent

    for li, line in ipairs(lines) do
        local lineStart = 0
        if align == E.ALIGN_CENTER then
            lineStart = -line.widthPx / 2
        elseif align == E.ALIGN_RIGHT then
            lineStart = -line.widthPx
        end
        for gi = 1, #line.glyphs do
            local g = line.glyphs[gi]
            g.xPx = g.xPx + lineStart
            g.baselinePx = firstBase - (li - 1) * lineHeight
        end
    end

    local left, right
    if align == E.ALIGN_CENTER then
        left, right = -maxWidth / 2, maxWidth / 2
    elseif align == E.ALIGN_RIGHT then
        left, right = -maxWidth, 0
    else
        left, right = 0, maxWidth
    end
    local top = anchorOff + blockH / 2
    local bottom = anchorOff - blockH / 2

    return {
        lines = lines,
        glyphs = glyphs,
        widthPx = maxWidth,
        heightPx = blockH,
        ascentPx = ascent,
        descentPx = descent,
        lineHeightPx = lineHeight,
        lineCount = n,
        bounds = { left = left, right = right, bottom = bottom, top = top },
    }
end

-----------------------------------------------------------------------------
-- Segmentation
-----------------------------------------------------------------------------

-- Returns the horizontal offset for one glyph when per-segment tracking is
-- active.  Tracking is measured in pixels per gap and is centred on the line,
-- so a positive value spreads the line outwards from its middle and a negative
-- value pulls it together, without moving the block anchor.  n is the number of
-- clusters on the line; a one-cluster line has nothing to spread.
function E.trackShift(g, trackingPx)
    local n = g.clusterCount or 0
    if n <= 1 then return 0 end
    local idx = (g.clusterInLine or 1) - 1
    return (trackingPx or 0) * (idx - (n - 1) / 2)
end

-- Adds a .segment field to non-space glyphs and returns the segment list.
-- Character mode keeps combining marks with their base glyph.
-- Word mode groups consecutive non-space clusters on a line.
-- Line mode makes one segment per line that contains visible glyphs.
function E.buildSegments(layout, mode)
    local segments = {}
    local glyphs = layout.glyphs
    mode = E.sanitizeInt(mode, E.SEQ_CHARACTER, 0, 2)

    if mode == E.SEQ_CHARACTER then
        local current = nil
        local lastCluster = nil
        for i = 1, #glyphs do
            local g = glyphs[i]
            if g.isSpace then
                current = nil
            else
                if current == nil or g.cluster ~= lastCluster then
                    current = { glyphs = {} }
                    segments[#segments + 1] = current
                end
                current.glyphs[#current.glyphs + 1] = g
                g.segment = #segments
            end
            lastCluster = g.cluster
        end
    elseif mode == E.SEQ_WORD then
        local current = nil
        local lastLine = nil
        for i = 1, #glyphs do
            local g = glyphs[i]
            if g.line ~= lastLine then current = nil end
            if g.isSpace then
                current = nil
            else
                if current == nil then
                    current = { glyphs = {} }
                    segments[#segments + 1] = current
                end
                current.glyphs[#current.glyphs + 1] = g
                g.segment = #segments
            end
            lastLine = g.line
        end
    else
        local byLine = {}
        for i = 1, #glyphs do
            local g = glyphs[i]
            if not g.isSpace then
                local seg = byLine[g.line]
                if not seg then
                    seg = { glyphs = {} }
                    byLine[g.line] = seg
                    segments[#segments + 1] = seg
                end
                seg.glyphs[#seg.glyphs + 1] = g
                g.segment = #segments
            end
        end
    end
    return segments
end

-----------------------------------------------------------------------------
-- Ordering
-----------------------------------------------------------------------------

local function randomSeed(seed)
    seed = math.floor(seed or 1)
    if seed <= 0 then seed = 1 end
    return seed % 2147483647
end

-- Deterministic LCG (Lehmer / Park-Miller).  Lua 5.1 has no bit operators.
local function lcgNext(state)
    state = (state * 48271) % 2147483647
    if state <= 0 then state = state + 2147483646 end
    return state, state / 2147483647
end

-- Returns rank[segmentIndex] = 0..count-1.
function E.computeRanks(count, order, seed)
    count = math.floor(tonumber(count) or 0)
    local ranks = {}
    if count <= 0 then return ranks end
    order = E.sanitizeInt(order, E.ORDER_FORWARD, 0, 4)

    local idx = {}
    for i = 1, count do idx[i] = i end

    if order == E.ORDER_REVERSE then
        for i = 1, count do ranks[i] = count - i end
        return ranks
    elseif order == E.ORDER_FORWARD then
        for i = 1, count do ranks[i] = i - 1 end
        return ranks
    end

    if order == E.ORDER_CENTER_OUT or order == E.ORDER_OUTSIDE_IN then
        local center = (count + 1) / 2
        table.sort(idx, function(a, b)
            local da = math.abs(a - center)
            local db = math.abs(b - center)
            if da == db then return a < b end
            return da < db
        end)
        for pos = 1, count do
            local seg = idx[pos]
            if order == E.ORDER_CENTER_OUT then
                ranks[seg] = pos - 1
            else
                ranks[seg] = count - pos
            end
        end
        return ranks
    end

    -- Random: shuffle a copy of the index list.  The result depends only on
    -- count and seed, never on playback history.
    local state = randomSeed(seed)
    for i = count, 2, -1 do
        local r
        state, r = lcgNext(state)
        local j = 1 + math.floor(r * i)
        if j < 1 then j = 1 end
        if j > i then j = i end
        idx[i], idx[j] = idx[j], idx[i]
    end
    for pos = 1, count do
        ranks[idx[pos]] = pos - 1
    end
    return ranks
end

-----------------------------------------------------------------------------
-- Timing
-----------------------------------------------------------------------------

function E.computeTiming(p, count)
    count = math.max(1, math.floor(tonumber(count) or 1))
    local inDuration = p.inDuration
    local inStagger = p.inStagger
    local outDuration = p.outDuration
    local outStagger = p.outStagger

    if p.fitIn then
        local total = math.max(0, p.inTotal)
        inDuration = math.min(inDuration, total)
        if count > 1 then
            inStagger = math.max(0, (total - inDuration) / (count - 1))
        else
            inStagger = 0
        end
    end
    if p.fitOut then
        local total = math.max(0, p.outTotal)
        outDuration = math.min(outDuration, total)
        if count > 1 then
            outStagger = math.max(0, (total - outDuration) / (count - 1))
        else
            outStagger = 0
        end
    end

    return {
        inDuration = inDuration,
        inStagger = inStagger,
        outDuration = outDuration,
        outStagger = outStagger,
    }
end

------------------------------------------------------------------------------
-- Easing
------------------------------------------------------------------------------

local TWO_PI = 2 * math.pi

-- Damped-spring ease-out.
--
-- Penner's elastic-out oscillates about three times.  That is fine at 60 fps
-- but at the 8-24 frame durations this Fuse is normally used with, the
-- oscillation is sampled only 2-4 times per cycle: it aliases into a buzz.
-- This spring starts with zero velocity, then overshoots and settles.  `cycles`
-- sets how many oscillations fit in t = 0..1, `damping` sets how quickly they
-- die away.  The result is normalised so it ends at exactly 1 instead of
-- 1 - epsilon.
local function springOut(t, cycles, damping)
    local b = TWO_PI * cycles
    local function raw(x)
        local decay = math.exp(-damping * x)
        return 1 - decay * (math.cos(b * x) + (damping / b) * math.sin(b * x))
    end
    return raw(t) / raw(1)
end

-- Elastic gets its own time warp: phase = t^1.8.  A plain multi-cycle spring
-- reaches its first peak within the first two frames of a 12-frame entrance,
-- so almost the whole move happens at once.  Warping the phase leaves the
-- first frames gentle and still fits 2-4 oscillations into the segment.
local function elasticOut(t, cycles, damping)
    cycles = E.sanitizeNumber(cycles, E.ELASTIC_CYCLES,
        E.ELASTIC_MIN_CYCLES, E.ELASTIC_MAX_CYCLES)
    damping = E.sanitizeNumber(damping, E.ELASTIC_DAMPING,
        E.ELASTIC_MIN_DAMPING, E.ELASTIC_MAX_DAMPING)
    return springOut(t ^ E.ELASTIC_TIME_WARP, cycles, damping)
end

-- A single, softer overshoot with no secondary wobble.
local function backOut(t)
    return springOut(t, 1, 6)
end

-- Two readable bounces.  Penner's four arcs put each bounce in 1-2 frames at
-- a 12-frame duration, which reads as jitter rather than a bounce.  Here the
-- fall takes the first half, then two bounces decay 12% -> 3.5% of the travel.
-- The fall is quadratic so it starts at rest and accelerates like gravity.
local function bounceOut(t)
    local land1, land2 = 0.5, 0.8
    local height1, height2 = 0.12, 0.035
    if t < land1 then
        local s = t / land1
        return s * s
    elseif t < land2 then
        local u = (t - land1) / (land2 - land1)
        return 1 - height1 * 4 * u * (1 - u)
    end
    local u = (t - land2) / (1 - land2)
    return 1 - height2 * 4 * u * (1 - u)
end

-- Monotonic fade curve, deliberately independent of the motion easing.
--
-- Alpha must never follow an overshooting curve: Bounce Out dips below 1 at
-- every rebound and Elastic/Back In go negative in the middle, which made the
-- letter dim, vanish or flash while it moved.  Smoothstep is monotonic and
-- never leaves 0..1, so the fade always reads as a fade.
function E.fadeProgress(t)
    t = E.clamp(tonumber(t) or 0, 0, 1)
    return t * t * (3 - 2 * t)
end

-- index must match E.EASING_NAMES.  Elastic, Back and Bounce intentionally
-- leave 0..1: the overshoot is the effect.  Callers clamp alpha, which must
-- stay in range, while movement, scale and blur use the curve directly.
function E.ease(index, t, elasticCycles, elasticDamping)
    t = E.clamp(tonumber(t) or 0, 0, 1)
    if t <= 0 then return 0 end
    if t >= 1 then return 1 end
    index = E.sanitizeInt(index, E.EASE_DEFAULT, 0, E.EASE_MAX)
    if index == 0 then                       -- Linear
        return t
    elseif index == 1 then                   -- Cubic In
        return t * t * t
    elseif index == 2 then                   -- Cubic Out
        local u = 1 - t
        return 1 - u * u * u
    elseif index == 3 then                   -- Cubic In Out
        if t < 0.5 then return 4 * t * t * t end
        local u = -2 * t + 2
        return 1 - (u * u * u) / 2
    elseif index == 4 then                   -- Elastic In
        return 1 - elasticOut(1 - t, elasticCycles, elasticDamping)
    elseif index == 5 then                   -- Elastic Out
        return elasticOut(t, elasticCycles, elasticDamping)
    elseif index == 6 then                   -- Back In
        return 1 - backOut(1 - t)
    elseif index == 7 then                   -- Back Out
        return backOut(t)
    elseif index == 8 then                   -- Bounce Out
        return bounceOut(t)
    elseif index == 9 then                   -- Expo In
        return 2 ^ (10 * t - 10)
    elseif index == 10 then                  -- Expo Out
        return 1 - 2 ^ (-10 * t)
    end
    return -(math.cos(math.pi * t) - 1) / 2  -- Sine In Out
end

-----------------------------------------------------------------------------
-- Parameter validation
-----------------------------------------------------------------------------

function E.directionVectors(index)
    local d = E.DIRECTIONS[E.sanitizeInt(index, 1, 0, 8)] or E.DIRECTIONS[0]
    return d[1], d[2], d[3], d[4]
end

-- raw fields use UI units where noted.  scaleIn/scaleOut are fractions
-- (1.0 = 100%), because the Fuse wrapper divides the percentage inputs.
function E.sanitizeParams(raw)
    raw = raw or {}
    local p = {}
    p.mode = E.sanitizeInt(raw.mode, E.MODE_IN_OUT, 0, 3)
    p.sequenceMode = E.sanitizeInt(raw.sequenceMode, E.SEQ_CHARACTER, 0, 2)
    p.order = E.sanitizeInt(raw.order, E.ORDER_FORWARD, 0, 4)
    p.seed = E.sanitizeInt(raw.seed, 12345, 0, 2147483646)
    p.startFrame = E.sanitizeNumber(raw.startFrame, 0, -1000000, 1000000)
    p.exitStart = E.sanitizeNumber(raw.exitStart, 72, -1000000, 1000000)
    p.speed = E.sanitizeNumber(raw.speed, 1, 0.01, 100)
    p.inDuration = E.sanitizeNumber(raw.inDuration, 12, 0, 100000)
    p.inStagger = E.sanitizeNumber(raw.inStagger, 2, 0, 100000)
    p.outDuration = E.sanitizeNumber(raw.outDuration, 12, 0, 100000)
    p.outStagger = E.sanitizeNumber(raw.outStagger, 2, 0, 100000)
    p.inTotal = E.sanitizeNumber(raw.inTotal, 60, 0, 100000)
    p.outTotal = E.sanitizeNumber(raw.outTotal, 60, 0, 100000)
    p.fitIn = E.sanitizeBool(raw.fitIn, false)
    p.fitOut = E.sanitizeBool(raw.fitOut, false)

    p.direction = E.sanitizeInt(raw.direction, 1, 0, 8)
    local dix, diy, dox, doy = E.directionVectors(p.direction)
    p.dirInX, p.dirInY, p.dirOutX, p.dirOutY = dix, diy, dox, doy
    p.distance = E.sanitizeNumber(raw.distance, 40, 0, 5000)
    p.settle = E.sanitizeBool(raw.settle, true)
    p.scaleIn = E.sanitizeNumber(raw.scaleIn, 1, 0.01, 10)
    p.scaleOut = E.sanitizeNumber(raw.scaleOut, 1, 0.01, 10)
    p.rotationIn = E.sanitizeNumber(raw.rotationIn, 0, -E.ROTATION_LIMIT, E.ROTATION_LIMIT)
    p.rotationOut = E.sanitizeNumber(raw.rotationOut, 0, -E.ROTATION_LIMIT, E.ROTATION_LIMIT)
    p.trackingIn = E.sanitizeNumber(raw.trackingIn, 0, -2000, 2000)
    p.trackingOut = E.sanitizeNumber(raw.trackingOut, 0, -2000, 2000)
    p.intensity = E.sanitizeNumber(raw.intensity, 1, 0, 2)

    p.easingIn = E.sanitizeInt(raw.easingIn, E.EASE_DEFAULT, 0, E.EASE_MAX)
    p.easingOut = E.sanitizeInt(raw.easingOut, E.EASE_DEFAULT_OUT, 0, E.EASE_MAX)
    p.elasticCycles = E.sanitizeNumber(raw.elasticCycles, E.ELASTIC_CYCLES,
        E.ELASTIC_MIN_CYCLES, E.ELASTIC_MAX_CYCLES)
    p.elasticDamping = E.sanitizeNumber(raw.elasticDamping, E.ELASTIC_DAMPING,
        E.ELASTIC_MIN_DAMPING, E.ELASTIC_MAX_DAMPING)

    p.fade = E.sanitizeBool(raw.fade, true)
    p.blur = E.sanitizeBool(raw.blur, true)
    p.blurAmount = E.sanitizeNumber(raw.blurAmount, 12, 0, 500)
    p.maxBlur = E.sanitizeNumber(raw.maxBlur, 120, 0, 500)

    p.size = E.sanitizeNumber(raw.size, 96, 1, 4000)
    p.tracking = E.sanitizeNumber(raw.tracking, 0, -2000, 2000)
    p.lineSpacing = E.sanitizeNumber(raw.lineSpacing, 1, 0.1, 5)
    p.align = E.sanitizeInt(raw.align, E.ALIGN_CENTER, 0, 2)
    p.valign = E.sanitizeInt(raw.valign, E.VALIGN_MIDDLE, 0, 2)
    p.posX = E.sanitizeNumber(raw.posX, 0.5, -10, 10)
    p.posY = E.sanitizeNumber(raw.posY, 0.5, -10, 10)
    p.opacity = E.sanitizeNumber(raw.opacity, 1, 0, 1)

    p.masterScale = E.sanitizeNumber(raw.masterScale, 1, 0.01, 10)
    p.masterRotation = E.sanitizeNumber(raw.masterRotation, 0, -3600, 3600)

    p.textR = E.sanitizeNumber(raw.textR, 1, 0, 1)
    p.textG = E.sanitizeNumber(raw.textG, 1, 0, 1)
    p.textB = E.sanitizeNumber(raw.textB, 1, 0, 1)
    p.textA = E.sanitizeNumber(raw.textA, 1, 0, 1)

    p.outline = E.sanitizeBool(raw.outline, false)
    p.outlineThickness = E.sanitizeNumber(raw.outlineThickness, 2, 0, 200)
    p.outlineR = E.sanitizeNumber(raw.outlineR, 0, 0, 1)
    p.outlineG = E.sanitizeNumber(raw.outlineG, 0, 0, 1)
    p.outlineB = E.sanitizeNumber(raw.outlineB, 0, 0, 1)
    p.outlineA = E.sanitizeNumber(raw.outlineA, 1, 0, 1)

    -- Diagnostic flag only. Not part of the documented animation controls.
    p.testFrame = raw.testFrame and true or false

    return p
end

-----------------------------------------------------------------------------
-- Per-segment state
-----------------------------------------------------------------------------

-- t is local animation time in frames.  rank is the segment's 0-based order.
-- Returns alpha (0..1, before the global text opacity is applied),
-- dx/dy in pixels, blur in pixels, scale (1 = normal), rotation in degrees
-- (0 = upright, added to Master Rotation) and tracking in pixels per gap.
function E.evaluateSegment(p, t, rank, timing)
    local st = { alpha = 1, dx = 0, dy = 0, blur = 0, scale = 1, rotation = 0,
        tracking = 0, animating = false }
    if p.mode == E.MODE_NONE then return st end

    local inStart = rank * timing.inStagger
    local inEnd = inStart + timing.inDuration
    local outStart = p.exitStart + rank * timing.outStagger
    local outEnd = outStart + timing.outDuration
    -- Exit cannot begin before entrance has finished for the same segment.
    if p.mode == E.MODE_IN_OUT and outStart < inEnd then
        outStart = inEnd
        outEnd = outStart + timing.outDuration
    end

    local hasIn = (p.mode == E.MODE_IN_OUT or p.mode == E.MODE_IN_ONLY)
    local hasOut = (p.mode == E.MODE_IN_OUT or p.mode == E.MODE_OUT_ONLY)
    local radius = p.distance * p.intensity
    -- When Settle To Layout is off, the entrance displacement is retained.
    local restX, restY = 0, 0
    if hasIn and not p.settle then
        restX = p.dirInX * radius
        restY = p.dirInY * radius
    end

    if hasIn and t < inEnd then
        -- Still inside the entrance: never batch this glyph into the static
        -- pass, even on a frame where the curve happens to return to rest
        -- (Bounce Out touches 0 displacement at each landing).
        st.animating = true
        local progress
        if t < inStart then
            progress = 0
            st.alpha = 0
        else
            if timing.inDuration <= 0 then
                progress = 1
            else
                progress = (t - inStart) / timing.inDuration
            end
            progress = E.clamp(progress, 0, 1)
        end
        local e = E.ease(p.easingIn, progress, p.elasticCycles, p.elasticDamping)
        local factor
        if p.settle then
            factor = 1 - e
        else
            factor = 2 - e
        end
        st.dx = p.dirInX * radius * factor
        st.dy = p.dirInY * radius * factor
        if p.fade then st.alpha = E.fadeProgress(progress) else st.alpha = 1 end
        if t < inStart then st.alpha = 0 end
        if p.blur then
            st.blur = math.max(0, p.blurAmount * (1 - e) * p.intensity)
        end
        st.scale = math.max(0.01, 1 + (p.scaleIn - 1) * (1 - e) * p.intensity)
        st.rotation = p.rotationIn * (1 - e) * p.intensity
        st.tracking = p.trackingIn * (1 - e) * p.intensity
        return st
    end

    if hasOut and t >= outStart then
        if t >= outEnd then
            st.alpha = 0
            return st
        end
        st.animating = true
        local progress
        if timing.outDuration <= 0 then
            progress = 1
        else
            progress = (t - outStart) / timing.outDuration
        end
        progress = E.clamp(progress, 0, 1)
        local e = E.ease(p.easingOut, progress, p.elasticCycles, p.elasticDamping)
        if hasIn and not p.settle then
            -- Continue from the retained entrance position and travel a full
            -- distance in the exit direction.
            st.dx = restX + p.dirOutX * radius * 2 * e
            st.dy = restY + p.dirOutY * radius * 2 * e
        else
            st.dx = p.dirOutX * radius * e
            st.dy = p.dirOutY * radius * e
        end
        if p.fade then st.alpha = 1 - E.fadeProgress(progress) else st.alpha = 1 end
        if p.blur then
            st.blur = math.max(0, p.blurAmount * e * p.intensity)
        end
        st.scale = math.max(0.01, 1 + (p.scaleOut - 1) * e * p.intensity)
        st.rotation = p.rotationOut * e * p.intensity
        st.tracking = p.trackingOut * e * p.intensity
        return st
    end

    st.dx = restX
    st.dy = restY
    return st
end

function E.isFinalState(st)
    return st.alpha >= 0.9999
        and math.abs(st.dx) < 1e-6
        and math.abs(st.dy) < 1e-6
        and st.blur < 1e-6
        and math.abs(st.scale - 1) < 1e-6
        and math.abs(st.rotation or 0) < 1e-6
        and math.abs(st.tracking or 0) < 1e-6
end

-- Whether this glyph must be drawn through the per-glyph cell path.
--
-- Geometry alone is not enough: Bounce Out returns to zero displacement at
-- every landing while the segment is still animating.  Treating those frames
-- as settled switched the glyph from a cell to the static batched shape for
-- exactly one frame, which showed up as a pop.  The animating flag keeps the
-- render path stable for the whole entrance/exit.
function E.needsCell(st)
    if st.alpha <= 0.001 then return false end
    return st.animating or not E.isFinalState(st)
end

