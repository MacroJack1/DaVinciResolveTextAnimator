            InDuration = 16, InStagger = 1.5,
            OutDuration = 12, OutStagger = 1.5,
            Direction = 0, Distance = 0,
            EaseIn = 2, EaseOut = 2,
            Fade = 1, Blur = 0, BlurAmount = 0,
            ScaleIn = 50, ScaleOut = 50,
            RotationIn = 0, RotationOut = 0,
            TrackingIn = 0, TrackingOut = 0,
        },
    },
}

function E.presetValues(index)
    local result = {}
    for k, v in pairs(E.DEFAULT_ANIMATION) do result[k] = v end
    index = math.floor(tonumber(index) or 0)
    local preset = E.PRESETS[index + 1]
    if preset then
        for k, v in pairs(preset.values) do result[k] = v end
    end
    return result
end

function E.presetName(index)
    local preset = E.PRESETS[(math.floor(tonumber(index) or 0)) + 1]
    return preset and preset.name or "Default"
end

--===========================================================================
-- PART 2 - FUSE UI
--===========================================================================

local selectedPreset = 0
local PresetInputs = {}

local function addColorGroup(tool, prefix, label, group, r, g, b, a)
    local InR = tool:AddInput("Red", prefix .. "R", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        IC_ControlGroup = group,
        IC_ControlID = 0,
        ICS_Name = label,
        INP_MinScale = 0,
        INP_MaxScale = 1,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 1,
        INP_Default = r,
    })
    local InG = tool:AddInput("Green", prefix .. "G", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        IC_ControlGroup = group,
        IC_ControlID = 1,
        ICS_Name = label,
        INP_MinScale = 0,
        INP_MaxScale = 1,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 1,
        INP_Default = g,
    })
    local InB = tool:AddInput("Blue", prefix .. "B", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        IC_ControlGroup = group,
        IC_ControlID = 2,
        ICS_Name = label,
        INP_MinScale = 0,
        INP_MaxScale = 1,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 1,
        INP_Default = b,
    })
    local InA = tool:AddInput("Alpha", prefix .. "A", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        IC_ControlGroup = group,
        IC_ControlID = 3,
        ICS_Name = label,
        INP_MinScale = 0,
        INP_MaxScale = 1,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 1,
        INP_Default = a,
    })
    return InR, InG, InB, InA
end

-- Image I/O is created separately and first.
--
-- Background deliberately has NO LINK_Main attribute.  LINK_Main marks an
-- input as one of the tool's *main* image inputs (1 = first, 2 = second), and
-- Fusion builds the render request around those.  An optional background that
-- is normally unconnected must be an ordinary image input instead:
--
--   LINK_Main = 1 (1.0.0-1.0.3): tool treated as a filter with a missing main
--     image -> Media Out "cannot get Parameter for Input", Process never called.
--   LINK_Main = 2 (1.0.4): still a main input, but the Output's LINK_Main = 1
--     then refers to a main input that does not exist -> same failure.
--   no LINK_Main (1.0.5+): the Fuse is a generator with an optional image
--     input, the same shape as the built-in Text+ background input.
local function makeOutput()
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })
end

local function buildIO()
    InBackground = self:AddInput("Background", "Background", {
        LINKID_DataType = "Image",
        INP_Required = false,
        INPS_StatusText = "Optional background image. Without it the comp frame size is used.",
    })
    makeOutput()
end

-- Tabs are created with a single call; every control that follows belongs to
-- that page until the next call.  The call is guarded so a host that does not
-- expose AddControlPage still gets a working, if untabbed, Inspector.
local function addControlPage(name)
    if type(self.AddControlPage) ~= "function" then
        dbg("addControlPage: unsupported host, continuing without tab", name)
        return false
    end
    local ok, err = pcall(function() self:AddControlPage(name) end)
    if not ok then
        dbg("addControlPage failed for", name, ":", tostring(err))
        return false
    end
    return true
end

local function buildControls()
    addControlPage("Text")

    -------------------------------------------------------------------------
    -- Presets
    -------------------------------------------------------------------------
    self:BeginControlNest("Presets", "Presets", true)
    InPreset = self:AddInput("Preset", "Preset", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
        INP_DoNotifyChanged = true,
        INP_External = false,
        INP_Default = 0,
        { CCS_AddString = "Default" },
        { CCS_AddString = "Fade" },
        { CCS_AddString = "Elastic" },
        { CCS_AddString = "Slide" },
        { CCS_AddString = "Scale" },
    })
    InApplyPreset = self:AddInput("Apply Preset", "ApplyPreset", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ButtonControl",
        INP_DoNotifyChanged = true,
        INP_External = false,
        INP_Default = 0,
        BTNC_Align = "Left",
    })
    self:AddInput("Presets change animation controls only; text, font, colour, size and position are preserved.", "PresetHelp", {
        LINKID_DataType = "Text",
        INPID_InputControl = "LabelControl",
        INP_Passive = true,
        INP_External = false,
    })
    self:EndControlNest()

    -------------------------------------------------------------------------
    -- Text
    -------------------------------------------------------------------------
    self:BeginControlNest("Text", "TextNest", true)
    InText = self:AddInput("Text", "Text", {
        LINKID_DataType = "Text",
        INPID_InputControl = "TextEditControl",
        INPS_DefaultText = "TEXT ANIMATOR\nMADE FOR FUSION",
        TEC_Lines = 4,
        TEC_Wrap = true,
    })
    self:EndControlNest()

    -------------------------------------------------------------------------
    -- Style: typography and outline
    -------------------------------------------------------------------------
    addControlPage("Style")
    self:BeginControlNest("Typography", "TypographyNest", true)
    InFont = self:AddInput("Font", "Font", {
        LINKID_DataType = "Text",
        INPID_InputControl = "FontFileControl",
        IC_ControlGroup = 2,
        IC_ControlID = 0,
        INP_Level = 1,
        INP_DoNotifyChanged = true,
        INP_External = false,
    })
    InFontStyle = self:AddInput("Style", "FontStyle", {
        LINKID_DataType = "Text",
        INPID_InputControl = "FontFileControl",
        IC_ControlGroup = 2,
        IC_ControlID = 1,
        INP_Level = 1,
        INP_DoNotifyChanged = true,
        INP_External = false,
    })
    InSize = self:AddInput("Size (px)", "Size", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 8,
        INP_MaxScale = 400,
        INP_MinAllowed = 1,
        INP_MaxAllowed = 4000,
        INP_Default = 96,
        INP_DoNotifyChanged = false,
    })
    InAlign = self:AddInput("Alignment", "Alignment", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
        INP_Default = 1,
        { CCS_AddString = "Left" },
        { CCS_AddString = "Center" },
        { CCS_AddString = "Right" },
    })
    InVAlign = self:AddInput("Vertical Alignment", "VAlignment", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
        INP_Default = 1,
        { CCS_AddString = "Top" },
        { CCS_AddString = "Middle" },
        { CCS_AddString = "Bottom" },
    })
    InTracking = self:AddInput("Tracking (px)", "Tracking", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = -20,
        INP_MaxScale = 80,
        INP_MinAllowed = -2000,
        INP_MaxAllowed = 2000,
        INP_Default = 0,
    })
    InLineSpacing = self:AddInput("Line Spacing", "LineSpacing", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0.5,
        INP_MaxScale = 3,
        INP_MinAllowed = 0.1,
        INP_MaxAllowed = 5,
        INP_Default = 1,
    })
    InPosition = self:AddInput("Position", "Position", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INP_DefaultX = 0.5,
        INP_DefaultY = 0.5,
    })
    InOpacity = self:AddInput("Opacity", "Opacity", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0,
        INP_MaxScale = 1,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 1,
        INP_Default = 1,
    })
    InTextR, InTextG, InTextB, InTextA = addColorGroup(self, "TextColor", "Text Colour", 3, 1, 1, 1, 1)
    self:EndControlNest()

    self:BeginControlNest("Outline", "OutlineNest", true)
    InOutline = self:AddInput("Enable Outline", "Outline", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Integer = true,
        INP_Default = 0,
    })
    InOutlineThickness = self:AddInput("Outline Thickness (px)", "OutlineThickness", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_MinScale = 0,
        INP_MaxScale = 12,
        INP_MinAllowed = 0,
        INP_MaxAllowed = 200,
        INP_Default = 2,
    })
    InOutlineR, InOutlineG, InOutlineB, InOutlineA = addColorGroup(self, "OutlineColor", "Outline Colour", 4, 0, 0, 0, 1)
    self:EndControlNest()

    -------------------------------------------------------------------------
    -- Animation: sequence, timing, movement, easing, fade and blur
    addControlPage("Animation")

    -------------------------------------------------------------------------
    -- Sequence
    -------------------------------------------------------------------------
    self:BeginControlNest("Sequence", "Sequence", true)
    InSequence = self:AddInput("Animate By", "SequenceMode", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
        INP_Default = 0,
        { CCS_AddString = "Characters" },
        { CCS_AddString = "Words" },
        { CCS_AddString = "Lines" },
    })
    InAnimMode = self:AddInput("Animation", "AnimationMode", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Integer = true,
